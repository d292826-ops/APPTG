[Unit]
Description=Telegram meeting booking bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=googlebot
Group=googlebot
WorkingDirectory=/opt/googlebot
ExecStart=/opt/googlebot/.venv/bin/python -u /opt/googlebot/bot.py
Restart=always
RestartSec=15
TimeoutStopSec=40
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TELEGRAM_IPV4_ONLY=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/googlebot/data

[Install]
WantedBy=multi-user.target
